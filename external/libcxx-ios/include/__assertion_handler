// Vendored stand-in for the CMake-generated __assertion_handler.
// Hardening is compiled out, but the macro must still exist for sources that
// reference it directly (new.cpp etc.).
#ifndef _LIBCPP___ASSERTION_HANDLER
#define _LIBCPP___ASSERTION_HANDLER

#ifndef _LIBCPP_ASSERTION_HANDLER
#define _LIBCPP_ASSERTION_HANDLER(...) std::__libcpp_verbose_abort(__VA_ARGS__)
#endif

#endif // _LIBCPP___ASSERTION_HANDLER
